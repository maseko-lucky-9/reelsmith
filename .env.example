# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg URL — matches the docker-compose.yml defaults
YTVIDEO_DB_URL=postgresql+asyncpg://reelsmith:reelsmith@localhost/reelsmith

# "sql"    → Postgres-backed store (production default)
# "memory" → in-memory store (fast unit tests, no DB needed)
YTVIDEO_JOB_STORE=sql
# Skip `alembic upgrade head` at API start-up (sql store only). Renamed from the
# unprefixed SKIP_ALEMBIC, which is no longer read.
# YTVIDEO_SKIP_ALEMBIC=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Root log level: DEBUG | INFO | WARNING | ERROR (unknown → INFO).
# YTVIDEO_LOG_LEVEL=INFO

# ── Jobs & concurrency ────────────────────────────────────────────────────────
YTVIDEO_MAX_CONCURRENT_JOBS=1
YTVIDEO_MAX_PARALLEL_CHAPTERS=1
YTVIDEO_MAX_THREAD_WORKERS=4

# ── Pipeline defaults ─────────────────────────────────────────────────────────
# Where source videos (kept for re-render), uploads and job output folders
# go. Default: <project>/data/downloads (gitignored, created on first use).
# Avoid /tmp: macOS clears it and re-render then fails with
# "source video not retained".
# YTVIDEO_DEFAULT_DOWNLOAD_PATH=
YTVIDEO_DEFAULT_CAPTION_FORMAT=srt
YTVIDEO_DEFAULT_TARGET_ASPECT_RATIO=0.5625
YTVIDEO_DEFAULT_TRANSCRIPTION_LANGUAGE=en-US
# Caption font. Default: the bundled app/assets/fonts/Anton-Regular.ttf, then
# macOS Arial Bold / Arial / Helvetica, whichever exists first.
# YTVIDEO_FONT_PATH=

# ── Transcription ─────────────────────────────────────────────────────────────
# "whisper" → faster-whisper (local GPU/CPU)
# "stub"    → returns empty transcript (tests / CI without GPU)
YTVIDEO_TRANSCRIPTION_PROVIDER=whisper
YTVIDEO_WHISPER_MODEL=base
# Decode settings chosen by scripts/bench_whisper.py: beam 1 + VAD is ~2x faster
# than beam 5 and matched the reference transcript better. Beam 1 needs VAD:
# without it Whisper skips speech that follows a long silence.
# YTVIDEO_WHISPER_BEAM_SIZE=1
# YTVIDEO_WHISPER_VAD_FILTER=true
# CTranslate2 CPU threads. 8 was fastest on the bench host; set 0 (library
# default, 4) on hosts with fewer than 8 cores.
# YTVIDEO_WHISPER_CPU_THREADS=8
# Load the model in the background at API start-up (whisper provider only) so
# the first job doesn't pay for it.
# YTVIDEO_WHISPER_WARMUP=true

# ── Segment scoring ───────────────────────────────────────────────────────────
# "local_heuristic" → librosa + VADER + spaCy heuristics (Phase 4)
# "chapter"         → cut on YouTube chapters (current default, fully backwards-compat)
# "stub"            → returns fixed scores (tests)
YTVIDEO_SEGMENT_PROVIDER=chapter
YTVIDEO_TARGET_CLIP_SECONDS_MIN=20
YTVIDEO_TARGET_CLIP_SECONDS_MAX=60
# JSON object of weights (must sum to 1.0)
YTVIDEO_SCORE_WEIGHTS={"hook":0.30,"value":0.25,"emotion":0.15,"audio":0.15,"trend":0.15}
# Optional re-rank of the discovered clips by a local LLM (ADR-007, Re-rank).
# Applies only when discovery runs (a provider other than "chapter" above).
# "none"   → the heuristic's ranking only (default)
# "ollama" → one call per job to YTVIDEO_OLLAMA_MODEL at YTVIDEO_OLLAMA_BASE_URL
#            (needs YTVIDEO_OLLAMA_ENABLED=true; Ollama 0.5+ for its JSON
#            schema output; thinking is turned off). Up to 10 distinct
#            candidates, 600 bytes (UTF-8) of transcript each, are scored
#            0-100 and blended 50/50 with the heuristic score before the usual
#            selection. The model only returns scores: it cannot add, move
#            or retitle a clip. Ollama down, a timeout
#            (YTVIDEO_OLLAMA_TIMEOUT_SECONDS bounds the call), or a bad,
#            cut-off or partial reply keeps the heuristic's ranking.
# YTVIDEO_SEGMENT_RERANK_PROVIDER=none

# ── Reframe ───────────────────────────────────────────────────────────────────
# Applies when a job's "reframe" option is on.
# "letterbox"  → scaled inset over the blurred background (default)
# "face_track" → a 9:16 window pans with the speaker's face (YuNet face
#                detector on onnxruntime, sampled at 2 fps). Falls back to the
#                letterbox, with a StageSkipped(reframe) event, on a split
#                screen, several similar faces, no face, or any error.
# Any other value is treated as "letterbox".
YTVIDEO_REFRAME_PROVIDER=letterbox
# face_track downloads its face model (232 KB, SHA-256 pinned in
# app/services/face_detector.py) here on first use. Default:
# <project>/data/models (gitignored). Needs network once.
# YTVIDEO_REFRAME_MODEL_DIR=

# ── B-Roll ────────────────────────────────────────────────────────────────────
# Applies when a job's "broll" option is on: up to two 3 s inserts per reel,
# placed over its longest spoken keywords (never in the first 3 s or the last
# 2 s). Any provider failure renders the reel without B-roll and emits
# StageSkipped(broll).
# "none"   → no B-roll (default; StageSkipped(broll, "no provider"))
# "local"  → *.mp4 files in YTVIDEO_BROLL_LIBRARY_DIR named by keyword
#            (ocean_waves.mp4 answers "ocean" and "waves")
# "pexels" → Pexels video search; needs YTVIDEO_PEXELS_API_KEY below. Pexels
#            asks for credit: the export manifest's broll_credits column lists
#            the videographer and the video's Pexels page per insert.
YTVIDEO_BROLL_PROVIDER=none
# The local provider's library. Default: <project>/data/broll
# YTVIDEO_BROLL_LIBRARY_DIR=

# ── Media & retention ─────────────────────────────────────────────────────────
YTVIDEO_MAX_UPLOAD_MB=500
# Every YTVIDEO_RETENTION_SWEEP_MINUTES (SQL job store only) the janitor:
#  - retires clips older than YTVIDEO_RETENTION_DAYS and deletes their files;
#  - removes the source video, its .words.json sidecar and the emptied job
#    folders of a completed/failed job with no live clip, idle for
#    YTVIDEO_RETENTION_DAYS (and the last hour), with no reprompt running,
#    whose source lies under YTVIDEO_DEFAULT_DOWNLOAD_PATH (or the legacy
#    /tmp/yt/uploads) and is used by no other job; its re-render and reprompt
#    then answer 409 "source video not retained";
#  - deletes the files of retired clips (e.g. the clips a reprompt replaced)
#    once each file is older than YTVIDEO_RETIRED_FILES_GRACE_HOURS.
# exports/ copies and manifests are never swept.
YTVIDEO_RETENTION_DAYS=30
YTVIDEO_RETENTION_SWEEP_MINUTES=60
YTVIDEO_RETIRED_FILES_GRACE_HOURS=24

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set to true to have FastAPI serve the built React app at /
YTVIDEO_SERVE_FRONTEND=false

# ── Auth (Phase 8) ────────────────────────────────────────────────────────────
# YTVIDEO_REQUIRE_AUTH=false
# YTVIDEO_API_KEY=<generate with: openssl rand -hex 32>

# ── Multi-user auth (W3.8) ────────────────────────────────────────────────────
# false → current_user_id() is "local" and the API token resolver is bypassed.
# Flip to true after issuing the first API token.
# YTVIDEO_AUTH_ENABLED=false

# ── OAuth at-rest encryption (W1.3) ───────────────────────────────────────────
# Fernet key (URL-safe base64, 32 bytes). Unset → ephemeral in-process key, so
# stored tokens/cookies do not survive a restart. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# YTVIDEO_OAUTH_ENCRYPT_KEY=<PLACEHOLDER>

# ── Share links (W3.4) ────────────────────────────────────────────────────────
# HMAC secret for share-link tokens. Unset → random per-process secret, so links
# stop verifying after a restart. Generate with: openssl rand -hex 32
# YTVIDEO_SHARE_LINK_SECRET=<PLACEHOLDER>

# ── Voice-over (W2.3) ─────────────────────────────────────────────────────────
# .onnx model file for the piper voice-over provider.
# YTVIDEO_PIPER_MODEL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost dev origins.
YTVIDEO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rendering ─────────────────────────────────────────────────────────────────
YTVIDEO_CAPTION_WORDS_PER_SEGMENT=3
YTVIDEO_DOWNLOAD_TIMEOUT_SECONDS=600
YTVIDEO_TRANSCRIPTION_TIMEOUT_SECONDS=120
YTVIDEO_RENDER_TIMEOUT_SECONDS=3600

# ── Long-stage hardening (W2.10) ──────────────────────────────────────────────
# Seconds between keep-alive ': ping' comment frames on the job SSE stream
# (GET /jobs/{id}/events); 0 disables.
# YTVIDEO_SSE_KEEPALIVE_SECONDS=15
# Connection pool recycle (Postgres only).
# YTVIDEO_DB_POOL_RECYCLE_SECONDS=1800

# ── AI Hook (W1.7) / Ollama ───────────────────────────────────────────────────
# YTVIDEO_AI_HOOK_ENABLED=true
# YTVIDEO_AI_HOOK_MAX_CHARS=80
# YTVIDEO_OLLAMA_ENABLED=true
# YTVIDEO_OLLAMA_BASE_URL=http://localhost:11434
# YTVIDEO_OLLAMA_MODEL=mistral
# YTVIDEO_OLLAMA_TIMEOUT_SECONDS=60

# ── Speech enhancement (W1.8) ─────────────────────────────────────────────────
# "loudnorm" | "rnnoise" | "passthrough"
# YTVIDEO_AUDIO_ENHANCE_PROVIDER=loudnorm
# arnndn model file for the rnnoise provider
# YTVIDEO_AUDIO_ENHANCE_RNNOISE_MODEL=

# ── B-Roll Pexels (W1.9) ──────────────────────────────────────────────────────
# Used when YTVIDEO_BROLL_PROVIDER=pexels. The key (free at
# https://www.pexels.com/api) is sent only as the search request's
# Authorization header and never logged; without it the provider finds
# nothing. Downloads (mp4, at most 50 MB, only from *.pexels.com) are cached
# in YTVIDEO_BROLL_CACHE_DIR by Pexels video id (gitignored).
# YTVIDEO_PEXELS_API_KEY=<PLACEHOLDER>
# YTVIDEO_BROLL_CACHE_DIR=data/broll-cache

# ── Bulk export (W3.7) ────────────────────────────────────────────────────────
# Max clips per GET /api/clips/bulk-export.zip (stored zip, streamed).
# YTVIDEO_BULK_EXPORT_MAX_CLIPS=200

# ── Social adapter selection (W1.5) ───────────────────────────────────────────
# Global provider: stub | real. A non-empty per-platform value wins over it.
# YouTube: real. TikTok: cookie | n8n. Instagram / LinkedIn / X: stub only today
# (any other value falls back to stub).
# Behaviour change: these are read through Settings, so a value in this .env
# file is now honoured. Before, only a shell-exported variable worked and a .env
# value was ignored, e.g. YTVIDEO_SOCIAL_PROVIDER_TIKTOK=cookie in .env now
# switches TikTok from the stub to live cookie uploads.
# YTVIDEO_SOCIAL_PROVIDER=stub
# YTVIDEO_SOCIAL_PROVIDER_YOUTUBE=
# YTVIDEO_SOCIAL_PROVIDER_TIKTOK=
# YTVIDEO_SOCIAL_PROVIDER_INSTAGRAM=
# YTVIDEO_SOCIAL_PROVIDER_LINKEDIN=
# YTVIDEO_SOCIAL_PROVIDER_X=

# ── TikTok publishing ─────────────────────────────────────────────────────────
# The cookie adapter needs a stable YTVIDEO_OAUTH_ENCRYPT_KEY (see above).
# YTVIDEO_TIKTOK_COOKIES_DIR=data/tiktok-cookies
# YTVIDEO_TIKTOK_SESSION_TTL_DAYS=21
# n8n sidecar path, e.g. http://tiktok-sidecar.n8n-live.svc.cluster.local:8000/api/upload
# YTVIDEO_TIKTOK_SIDECAR_URL=

# ── Generate mode (Stage 1) ───────────────────────────────────────────────────
# Text brief → AI b-roll + TTS voice-over → assembled mp4 → existing pipeline.
# Off by default, both producers on stub. Real providers (ltx / voicebox) need
# requirements-generate.txt and a GPU/MPS host.
# YTVIDEO_GENERATE_ENABLED=false
# YTVIDEO_GENERATE_BRIEF_DIR=data/generate-briefs
# "stub" | "ltx"
# YTVIDEO_LTX_PROVIDER=stub
# LTX subprocess path: all three must be set and exist, else NOT_CONFIGURED.
# YTVIDEO_LTX_PYTHON=
# YTVIDEO_LTX_INFERENCE_SCRIPT=
# YTVIDEO_LTX_PIPELINE_CONFIG=
# Portrait output (rounded to a multiple of 32 at call time)
# YTVIDEO_LTX_HEIGHT=1216
# YTVIDEO_LTX_WIDTH=704
# YTVIDEO_LTX_FRAME_RATE=24
# "stub" | "voicebox"
# YTVIDEO_GENERATE_TTS_PROVIDER=stub
# YTVIDEO_VOICEBOX_ENDPOINT=
# YTVIDEO_VOICEBOX_API_KEY=<PLACEHOLDER>
# YTVIDEO_VOICEBOX_ENGINE=kokoro
# YTVIDEO_GENERATE_VOICE_PROFILE=

# ── Social publish handoff ─────────────────────────────────────────────────────
# Root folder where finished clips + manifest.csv land for downstream n8n publishing.
# Each job writes to a dedicated sub-folder: <EXPORT_BASE_FOLDER>/<job_id>/
# Leave blank to use <download_path>/<video>/exports (no sub-folder per job).
YTVIDEO_EXPORT_BASE_FOLDER=
